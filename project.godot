; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="4 Nano Metre"
run/main_scene="res://scenes/character_select.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/yo/templerun/Idle__000.png"
boot_splash/bg_color=Color(0.15, 0.13, 0.12, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/game_state.gd"
BackgroundMusic="*res://scenes/background_music.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://ui/shift_theme.tres"

[input]

