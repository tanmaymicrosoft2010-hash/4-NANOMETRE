[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/floor_strip.gd" id="script"]
[ext_resource type="PackedScene" path="res://ui/shift_pause.tscn" id="pause"]

[sub_resource type="StyleBoxFlat" id="enamel"]
content_margin_left = 26.0
content_margin_top = 8.0
content_margin_right = 20.0
content_margin_bottom = 8.0
bg_color = Color(0.04, 0.08, 0.14, 0.95)
border_width_bottom = 2
border_color = Color(0.0, 0.70, 0.90, 0.85)

[node name="FloorStrip" type="PanelContainer"]
anchor_right = 1.0
custom_minimum_size = Vector2(0, 84)
theme_override_styles/panel = SubResource("enamel")
mouse_filter = 2
script = ExtResource("script")

[node name="Rail" type="HBoxContainer" parent="."]
theme_override_constants/separation = 30
mouse_filter = 2

[node name="SiteBlock" type="VBoxContainer" parent="Rail"]
size_flags_horizontal = 3
alignment = 1
theme_override_constants/separation = 0

[node name="LevelTag" type="Label" parent="Rail/SiteBlock"]
unique_name_in_owner = true
theme_type_variation = &"InkTag"
theme_override_font_sizes/font_size = 17
text = "LEVEL 01"

[node name="Site" type="Label" parent="Rail/SiteBlock"]
unique_name_in_owner = true
theme_type_variation = &"InkHeading"
theme_override_font_sizes/font_size = 27
text = "CORE RUN"

[node name="TimerBlock" type="VBoxContainer" parent="Rail"]
custom_minimum_size = Vector2(232, 0)
alignment = 1
theme_override_constants/separation = 0

[node name="FuseTag" type="Label" parent="Rail/TimerBlock"]
theme_type_variation = &"InkTag"
theme_override_font_sizes/font_size = 17
text = "BOMB FUSE"

[node name="TimerLabel" type="Label" parent="Rail/TimerBlock"]
unique_name_in_owner = true
theme_type_variation = &"InkHeading"
theme_override_font_sizes/font_size = 32
text = "05:00"

[node name="DotBlock" type="VBoxContainer" parent="Rail"]
custom_minimum_size = Vector2(270, 0)
alignment = 1
theme_override_constants/separation = 0

[node name="DotTag" type="Label" parent="Rail/DotBlock"]
theme_type_variation = &"InkTag"
theme_override_font_sizes/font_size = 17
text = "TIME DOTS"

[node name="DotRow" type="HBoxContainer" parent="Rail/DotBlock"]
theme_override_constants/separation = 26

[node name="GreenLabel" type="Label" parent="Rail/DotBlock/DotRow"]
unique_name_in_owner = true
theme_type_variation = &"Ink"
theme_override_colors/font_color = Color(0.16, 0.38, 0.19, 1)
theme_override_font_sizes/font_size = 20
text = "GREEN  0"

[node name="RedLabel" type="Label" parent="Rail/DotBlock/DotRow"]
unique_name_in_owner = true
theme_type_variation = &"Ink"
theme_override_colors/font_color = Color(0.55, 0.16, 0.11, 1)
theme_override_font_sizes/font_size = 20
text = "RED  0"

[node name="PauseSpace" type="Control" parent="Rail"]
custom_minimum_size = Vector2(150, 0)
mouse_filter = 2

[node name="ShiftPause" parent="." instance=ExtResource("pause")]
