one_shot = true

[connection signal="timeout" from="SiteClock" to="." method="_interrupt"]
[connection signal="timeout" from="GridRecovery" to="FlickerOverlay" method="hide"]
[connection signal="pressed" from="VCPopup/Mail/VCDismissButton" to="." method="_file_mail"]
