[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/character_select.gd" id="script"]
[ext_resource type="PackedScene" path="res://ui/desk.tscn" id="desk"]
[ext_resource type="PackedScene" path="res://ui/operator_badge.tscn" id="badge"]
[ext_resource type="Texture2D" path="res://ui/deck_stripe.tres" id="stripe"]

[node name="TitleScreen" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("script")

[node name="Desk" parent="." instance=ExtResource("desk")]

[node name="SafetyBand" type="TextureRect" parent="."]
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -80.0
offset_bottom = -68.0
texture = ExtResource("stripe")
texture_repeat = 2
expand_mode = 1
stretch_mode = 1
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 88.0
offset_bottom = -66.0

[node name="Counter" type="HBoxContainer" parent="Center"]
theme_override_constants/separation = 64

[node name="Cover" type="VBoxContainer" parent="Center/Counter"]
custom_minimum_size = Vector2(700, 0)
size_flags_vertical = 4
theme_override_constants/separation = 16

[node name="Edition" type="Label" parent="Center/Counter/Cover"]
theme_type_variation = &"Tag"
text = "4 NANO METRE FAB     /     NIGHT SHIFT"

[node name="TitleRow" type="HBoxContainer" parent="Center/Counter/Cover"]
theme_override_constants/separation = 20

[node name="Bar" type="ColorRect" parent="Center/Counter/Cover/TitleRow"]
custom_minimum_size = Vector2(10, 88)
size_flags_vertical = 4
mouse_filter = 2
color = Color(0.78, 0.37, 0.29, 1)

[node name="TitleLabel" type="Label" parent="Center/Counter/Cover/TitleRow"]
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 68
text = "4 NANO METRE"

[node name="Premise" type="Label" parent="Center/Counter/Cover"]
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 24
autowrap_mode = 3
text = "A bomb is ticking under the wafer line. Cross the floor and reach the core before the 5:00 fuse runs out."

[node name="FuseRow" type="HBoxContainer" parent="Center/Counter/Cover"]
theme_override_constants/separation = 16

[node name="Dot" type="ColorRect" parent="Center/Counter/Cover/FuseRow"]
custom_minimum_size = Vector2(18, 18)
size_flags_vertical = 4
mouse_filter = 2
color = Color(0.78, 0.24, 0.18, 1)

[node name="FuseTag" type="Label" parent="Center/Counter/Cover/FuseRow"]
theme_type_variation = &"Tag"
text = "BOMB FUSE"

[node name="FuseTime" type="Label" parent="Center/Counter/Cover/FuseRow"]
theme_type_variation = &"Heading"
theme_override_font_sizes/font_size = 34
text = "05:00"

[node name="FuseNote" type="Label" parent="Center/Counter/Cover/FuseRow"]
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 19
text = "Green +5s   /   Red -5s"

[node name="Actions" type="HBoxContainer" parent="Center/Counter/Cover"]
theme_override_constants/separation = 14

[node name="StartButton" type="Button" parent="Center/Counter/Cover/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(190, 54)
theme_type_variation = &"Primary"
text = "Play"

[node name="HowToButton" type="Button" parent="Center/Counter/Cover/Actions"]
custom_minimum_size = Vector2(220, 54)
text = "How to Play"

[node name="StoryButton" type="Button" parent="Center/Counter/Cover/Actions"]
custom_minimum_size = Vector2(150, 54)
text = "Story"

[node name="NoteRow" type="HBoxContainer" parent="Center/Counter/Cover"]
theme_override_constants/separation = 14

[node name="HardwareNote" type="Label" parent="Center/Counter/Cover/NoteRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 18
autowrap_mode = 3
text = "A/D or arrows move.  Space jumps.  Hold Right at the ladder to climb."

[node name="ConnectButton" type="Button" parent="Center/Counter/Cover/NoteRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 40)
theme_override_font_sizes/font_size = 18
text = "Connect ESP32"

[node name="OperatorBadge" parent="Center/Counter" instance=ExtResource("badge")]

[connection signal="pressed" from="Center/Counter/Cover/Actions/StartButton" to="." method="_play"]
[connection signal="pressed" from="Center/Counter/Cover/Actions/HowToButton" to="." method="_how_to"]
[connection signal="pressed" from="Center/Counter/Cover/Actions/StoryButton" to="." method="_clock_in"]
[connection signal="pressed" from="Center/Counter/Cover/NoteRow/ConnectButton" to="." method="_connect_hardware"]
